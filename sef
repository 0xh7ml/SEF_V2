#!/bin/bash

# SEF v2 - Subdomain Enumeration Framework
# Author: @0xh7ml

# Color codes
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BLUE='\033[0;34m'
NC='\033[0m'

# Default paths
TOOLS_DIR="$HOME/Tools"
WORDLIST="$TOOLS_DIR/subdomains-top1million-5000.txt"
RESOLVER="$TOOLS_DIR/resolvers.txt"
RESOLVER_TRUSTED="$TOOLS_DIR/resolvers_trusted.txt"
PERMUTATIONS_LIST="$TOOLS_DIR/permutations_list_short.txt"
PERMUTATIONS_LIST_FULL="$TOOLS_DIR/permutations_list.txt"
OUTPUT_DIR="Recon"

# Flags
DOMAIN=""
DOMAIN_LIST=""
WORDLIST_CUSTOM=""
RESOLVER_CUSTOM=""
QUICK_MODE=false
ALL_MODE=false
DEEP_MODE=false
CHECK_MODE=false
SILENT_MODE=false

# Display logo
logo() {
    [ "$SILENT_MODE" = true ] && return
    echo " _____ _____ _____"
    echo "/  ___|  ___|  ___|"
    echo "\  -- | |__ | |_"
    echo "  --  \  __||  _ |"
    echo "/\__/ / |___| |"
    echo "\____/\____/\_| @0xh7ml"
    echo "Subdomain Enumeration Framework v2.0"
    echo ""
}

# Display help
help() {
    echo "Usage: sef [options]"
    echo ""
    echo "Options:"
    echo "  -d <domain>         Target domain"
    echo "  -w <wordlist>       Custom wordlist for bruteforce"
    echo "  -r <resolvers>      Custom resolvers file"
    echo "  -o <output>         Output directory"
    echo "  --quick             Quick passive scan only"
    echo "  --all               Full enumeration (passive + active + permutation + csp + archive)"
    echo "  --deep              Deep scan with larger wordlists"
    echo "  --dLq <file>        Quick passive scan for domain list"
    echo "  --dLa <file>        Full scan for domain list"
    echo "  --check             Check if all required tools are installed"
    echo "  --silent            Silent mode (suppress banner and output headers)"
    echo "  -h, --help          Show this help message"
    echo ""
    echo "Examples:"
    echo "  sef -d example.com --quick"
    echo "  sef -d example.com -w wordlist.txt -r resolvers.txt --all -o output"
    echo "  sef --dLa domains.txt"
    echo "  sef --check"
    echo "  sef -d example.com --silent"
    echo ""
    exit 0
}

# Parse arguments
parse_args() {
    while [[ $# -gt 0 ]]; do
        case $1 in
            -d)
                DOMAIN="$2"
                shift 2
                ;;
            -w)
                WORDLIST_CUSTOM="$2"
                shift 2
                ;;
            -r)
                RESOLVER_CUSTOM="$2"
                shift 2
                ;;
            -o)
                OUTPUT_DIR="$2"
                shift 2
                ;;
            --quick)
                QUICK_MODE=true
                shift
                ;;
            --all)
                ALL_MODE=true
                shift
                ;;
            --deep)
                DEEP_MODE=true
                shift
                ;;
            --dLq)
                DOMAIN_LIST="$2"
                QUICK_MODE=true
                shift 2
                ;;
            --dLa)
                DOMAIN_LIST="$2"
                ALL_MODE=true
                shift 2
                ;;
            --check)
                CHECK_MODE=true
                shift
                ;;
            --silent)
                SILENT_MODE=true
                shift
                ;;
            -h|--help)
                help
                ;;
            *)
                echo -e "${RED}[!] Unknown option: $1${NC}"
                help
                ;;
        esac
    done
}

# Check if required tools are installed
check_tools() {
    echo -e "${YELLOW}[*] Checking required tools...${NC}"

    local required_tools=("subfinder" "httpx" "gotator" "anew" "shuffledns" "katana" "urlfinder" "unfurl")
    local missing=()

    for tool in "${required_tools[@]}"; do
        if ! command -v $tool &> /dev/null; then
            missing+=("$tool")
        fi
    done

    if [ ${#missing[@]} -gt 0 ]; then
        echo -e "${RED}[!] Missing required tools: ${missing[*]}${NC}"
        echo -e "${YELLOW}[!] Run 'sudo ./install.sh' to install all required tools${NC}"
        exit 1
    fi

    echo -e "${GREEN}[+] All required tools are installed${NC}"
}

# Passive subdomain enumeration
passive_enumeration() {
    local domain=$1
    local output_dir=$2

    echo -e "${BLUE}[*] Starting passive enumeration for $domain...${NC}"

    mkdir -p "$output_dir/passive"

    # Subfinder
    echo -e "${YELLOW}[*] Running subfinder...${NC}"
    subfinder -d "$domain" -silent 2>/dev/null | anew "$output_dir/passive/subfinder.txt" &>/dev/null &
    SF_PID=$!

    # Assetfinder
    echo -e "${YELLOW}[*] Running assetfinder...${NC}"
    assetfinder --subs-only "$domain" 2>/dev/null | anew "$output_dir/passive/assetfinder.txt" &>/dev/null &
    AF_PID=$!

    # CRT.sh
    if command -v crt &> /dev/null; then
        echo -e "${YELLOW}[*] Running crt...${NC}"
        crt "$domain" 2>/dev/null | anew "$output_dir/passive/crt.txt" &>/dev/null &
        CRT_PID=$!
    fi

    # GitHub subdomains
    if command -v github-subdomains &> /dev/null; then
        echo -e "${YELLOW}[*] Running github-subdomains...${NC}"
        github-subdomains -d "$domain" -t 100 2>/dev/null | anew "$output_dir/passive/github.txt" &>/dev/null &
        GH_PID=$!
    fi

    # GitLab subdomains
    if command -v gitlab-subdomains &> /dev/null; then
        echo -e "${YELLOW}[*] Running gitlab-subdomains...${NC}"
        gitlab-subdomains -d "$domain" -t 100 2>/dev/null | anew "$output_dir/passive/gitlab.txt" &>/dev/null &
        GL_PID=$!
    fi

    # Analytics relationships
    if command -v analyticsrelationships &> /dev/null; then
        echo -e "${YELLOW}[*] Running analyticsrelationships...${NC}"
        analyticsrelationships -d "$domain" 2>/dev/null | anew "$output_dir/passive/analytics.txt" &>/dev/null &
        AR_PID=$!
    fi

    # Wait for all passive tools
    wait $SF_PID $AF_PID 2>/dev/null
    [ -n "$CRT_PID" ] && wait $CRT_PID 2>/dev/null
    [ -n "$GH_PID" ] && wait $GH_PID 2>/dev/null
    [ -n "$GL_PID" ] && wait $GL_PID 2>/dev/null
    [ -n "$AR_PID" ] && wait $AR_PID 2>/dev/null

    # Merge all passive results
    cat "$output_dir/passive"/*.txt 2>/dev/null | sort -u | anew "$output_dir/passive/merged.txt" &>/dev/null

    local count=$(wc -l < "$output_dir/passive/merged.txt" 2>/dev/null || echo "0")
    echo -e "${GREEN}[+] Passive enumeration complete: $count subdomains${NC}"
}

# Active bruteforce enumeration
active_enumeration() {
    local domain=$1
    local output_dir=$2
    local wordlist=${3:-$WORDLIST}
    local resolver=${4:-$RESOLVER}

    echo -e "${BLUE}[*] Starting active enumeration for $domain...${NC}"

    mkdir -p "$output_dir/active"

    # Use puredns for bruteforce
    echo -e "${YELLOW}[*] Running puredns bruteforce...${NC}"
    puredns bruteforce "$wordlist" "$domain" -r "$resolver" --wildcard-tests 2>/dev/null | \
        sort -u | anew "$output_dir/active/bruteforce_raw.txt" &>/dev/null

    # Resolve the bruteforce results
    if [ -f "$output_dir/active/bruteforce_raw.txt" ]; then
        echo -e "${YELLOW}[*] Resolving bruteforce results...${NC}"
        puredns resolve "$output_dir/active/bruteforce_raw.txt" -r "$resolver_TRUSTED" --wildcard-tests 2>/dev/null | \
            sort -u | anew "$output_dir/active/resolved.txt" &>/dev/null
    fi

    local count=$(wc -l < "$output_dir/active/resolved.txt" 2>/dev/null || echo "0")
    echo -e "${GREEN}[+] Active enumeration complete: $count subdomains${NC}"
}

# Permutation enumeration
permutation_enumeration() {
    local domain=$1
    local output_dir=$2

    echo -e "${BLUE}[*] Starting permutation enumeration for $domain...${NC}"

    mkdir -p "$output_dir/permutation"

    # Check if we have existing subdomains to permute
    local base_subs="$output_dir/passive/merged.txt"
    if [ ! -f "$base_subs" ]; then
        echo -e "${YELLOW}[!] No base subdomains found for permutation${NC}"
        return
    fi

    local perm_list=$PERMUTATIONS_LIST
    if [ "$DEEP_MODE" = true ]; then
        perm_list=$PERMUTATIONS_LIST_FULL
    fi

    echo -e "${YELLOW}[*] Running gotator...${NC}"
    gotator -sub "$base_subs" -perm "$perm_list" -depth 1 -numbers 3 -mindup -adv -md 2>/dev/null | \
        sort -u | anew "$output_dir/permutation/gotator_raw.txt" &>/dev/null

    # Resolve permutations
    if [ -f "$output_dir/permutation/gotator_raw.txt" ]; then
        echo -e "${YELLOW}[*] Resolving permutations...${NC}"
        puredns resolve "$output_dir/permutation/gotator_raw.txt" -r "$RESOLVER_TRUSTED" 2>/dev/null | \
            sort -u | anew "$output_dir/permutation/resolved.txt" &>/dev/null
    fi

    local count=$(wc -l < "$output_dir/permutation/resolved.txt" 2>/dev/null || echo "0")
    echo -e "${GREEN}[+] Permutation enumeration complete: $count subdomains${NC}"
}

# CSP enumeration
csp_enumeration() {
    local domain=$1
    local output_dir=$2

    echo -e "${BLUE}[*] Starting CSP enumeration for $domain...${NC}"

    mkdir -p "$output_dir/csp"

    # CTFR
    if [ -f "$TOOLS_DIR/ctfr/ctfr.py" ]; then
        echo -e "${YELLOW}[*] Running ctfr...${NC}"
        python3 "$TOOLS_DIR/ctfr/ctfr.py" -d "$domain" -o "$output_dir/csp/ctfr.txt" &>/dev/null
    fi

    # Csprecon
    if command -v csprecon &> /dev/null; then
        echo -e "${YELLOW}[*] Running csprecon...${NC}"
        csprecon -d "$domain" -s 2>/dev/null | anew "$output_dir/csp/csprecon.txt" &>/dev/null
    fi

    # Katana web crawling
    if command -v katana &> /dev/null; then
        echo -e "${YELLOW}[*] Running katana...${NC}"
        # First need alive subdomains
        local alive_subs="$output_dir/subdomains_alive.txt"
        if [ -f "$alive_subs" ]; then
            katana -list "$alive_subs" -depth 2 -js-crawler -d 2 2>/dev/null | \
                unfurl -u domains 2>/dev/null | anew "$output_dir/csp/katana.txt" &>/dev/null
        fi
    fi

    # Merge CSP results
    cat "$output_dir/csp"/*.txt 2>/dev/null | grep -v "^$" | sort -u | anew "$output_dir/csp/merged.txt" &>/dev/null

    local count=$(wc -l < "$output_dir/csp/merged.txt" 2>/dev/null || echo "0")
    echo -e "${GREEN}[+] CSP enumeration complete: $count subdomains${NC}"
}

# Archive enumeration
archive_enumeration() {
    local domain=$1
    local output_dir=$2

    echo -e "${BLUE}[*] Starting archive enumeration for $domain...${NC}"

    mkdir -p "$output_dir/archive"

    # Waymore
    if command -v waymore &> /dev/null; then
        echo -e "${YELLOW}[*] Running waymore...${NC}"
        waymore -i "$domain" -mode V -f "$output_dir/archive/waymore.txt" 2>/dev/null
    fi

    # Roboxtractor
    if command -v roboxtractor &> /dev/null; then
        echo -e "${YELLOW}[*] Running roboxtractor...${NC}"
        echo "$domain" | roboxtractor 2>/dev/null | anew "$output_dir/archive/roboxtractor.txt" &>/dev/null
    fi

    # Merge archive results
    cat "$output_dir/archive"/*.txt 2>/dev/null | grep -v "^$" | sort -u | anew "$output_dir/archive/merged.txt" &>/dev/null

    local count=$(wc -l < "$output_dir/archive/merged.txt" 2>/dev/null || echo "0")
    echo -e "${GREEN}[+] Archive enumeration complete: $count subdomains${NC}"
}

# Resolve and validate subdomains
resolve_and_validate() {
    local output_dir=$1

    echo -e "${BLUE}[*] Resolving and validating subdomains...${NC}"

    # Gather all subdomains
    cat "$output_dir"/passive/*.txt "$output_dir"/active/*.txt "$output_dir"/permutation/*.txt "$output_dir"/csp/*.txt "$output_dir"/archive/*.txt 2>/dev/null | \
        grep -v "^$" | sort -u | anew "$output_dir/subdomains.txt" &>/dev/null

    # Resolve with dnsx
    echo -e "${YELLOW}[*] Resolving subdomains with dnsx...${NC}"
    dnsx -l "$output_dir/subdomains.txt" -r "$RESOLVER_TRUSTED" -silent -retry 3 2>/dev/null | \
        anew "$output_dir/subdomains_alive.txt" &>/dev/null

    # HTTP probe with httpx
    echo -e "${YELLOW}[*] Probing HTTP services with httpx...${NC}"
    httpx -l "$output_dir/subdomains_alive.txt" -silent -status-code -title 2>/dev/null | anew "$output_dir/subdomains_http.txt" &>/dev/null

    local total=$(wc -l < "$output_dir/subdomains.txt" 2>/dev/null || echo "0")
    local alive=$(wc -l < "$output_dir/subdomains_alive.txt" 2>/dev/null || echo "0")
    local http=$(wc -l < "$output_dir/subdomains_http.txt" 2>/dev/null || echo "0")

    echo -e "${GREEN}[+] Resolution complete:${NC}"
    echo -e "  - Total subdomains: $total"
    echo -e "  - Alive subdomains: $alive"
    echo -e "  - HTTP responding: $http"
}

# Main enumeration function for a single domain
enumerate_domain() {
    local domain=$1
    local output_dir="$OUTPUT_DIR/$domain"

    [ "$SILENT_MODE" = false ] && echo ""
    [ "$SILENT_MODE" = false ] && echo -e "${GREEN}========================================${NC}"
    [ "$SILENT_MODE" = false ] && echo -e "${GREEN}  Enumerating: $domain${NC}"
    [ "$SILENT_MODE" = false ] && echo -e "${GREEN}========================================${NC}"
    [ "$SILENT_MODE" = false ] && echo ""

    mkdir -p "$output_dir"

    # Always run passive enumeration
    passive_enumeration "$domain" "$output_dir"

    # Quick mode - stop after passive
    if [ "$QUICK_MODE" = true ]; then
        echo ""
        echo -e "${YELLOW}[!] Quick mode complete${NC}"
        resolve_and_validate "$output_dir"
        return
    fi

    # Full enumeration
    if [ "$ALL_MODE" = true ]; then
        # Active bruteforce
        local wordlist=${WORDLIST_CUSTOM:-$WORDLIST}
        local resolver=${RESOLVER_CUSTOM:-$RESOLVER}
        active_enumeration "$domain" "$output_dir" "$wordlist" "$resolver"

        # Permutation
        permutation_enumeration "$domain" "$output_dir"

        # CSP enumeration
        csp_enumeration "$domain" "$output_dir"

        # Archive enumeration
        archive_enumeration "$domain" "$output_dir"
    fi

    # Final resolution
    resolve_and_validate "$output_dir"
}

# Main function
main() {
    parse_args "$@"
    logo

    # Check mode - just verify tools and exit
    if [ "$CHECK_MODE" = true ]; then
        check_tools
        exit 0
    fi

    # Check for domain or domain list
    if [ -z "$DOMAIN" ] && [ -z "$DOMAIN_LIST" ]; then
        echo -e "${RED}[!] Error: Please specify a domain (-d) or domain list (--dLq/--dLa)${NC}"
        help
    fi

    # Check tools
    check_tools

    # Single domain
    if [ -n "$DOMAIN" ]; then
        enumerate_domain "$DOMAIN"
    fi

    # Domain list
    if [ -n "$DOMAIN_LIST" ]; then
        if [ ! -f "$DOMAIN_LIST" ]; then
            echo -e "${RED}[!] Error: Domain list file not found: $DOMAIN_LIST${NC}"
            exit 1
        fi

        [ "$SILENT_MODE" = false ] && echo ""
        [ "$SILENT_MODE" = false ] && echo -e "${BLUE}[*] Processing domain list: $DOMAIN_LIST${NC}"

        while IFS= read -r domain || [ -n "$domain" ]; do
            # Skip comments and empty lines
            [[ "$domain" =~ ^#.*$ ]] && continue
            [[ -z "$domain" ]] && continue

            enumerate_domain "$domain"
        done < "$DOMAIN_LIST"
    fi

    [ "$SILENT_MODE" = false ] && echo ""
    [ "$SILENT_MODE" = false ] && echo -e "${GREEN}========================================${NC}"
    [ "$SILENT_MODE" = false ] && echo -e "${GREEN}  Enumeration Complete!${NC}"
    [ "$SILENT_MODE" = false ] && echo -e "${GREEN}========================================${NC}"
    [ "$SILENT_MODE" = false ] && echo ""
    [ "$SILENT_MODE" = false ] && echo -e "${GREEN}[+] Results saved to: $OUTPUT_DIR/${NC}"
    [ "$SILENT_MODE" = false ] && echo ""
}

# Run main
main "$@"
